    class VideoManager {
      - m_renderer: SDL_Renderer*
      - m_window: SDL_Window*
      - m_currentWindowSize: Vec2
      - m_config: ConfigAdapter&
      - {static} initializeVideoSystem() : void
      - setupRenderer() : void
      - createRenderer() : SDL_Renderer*
      - createWindow() : SDL_Window*
      + VideoManager(config: ConfigAdapter&)
      + ~VideoManager()
      + getWindowSize() : Vec2
      + updateWindowSize() : void
      + getRenderer() : SDL_Renderer*
      + getWindow() : SDL_Window*
      + cleanup() : void
      + {static} isWebCanvasEnabled() : bool
    }
  }
}

' Configuration subsystem
package "Configuration" {
  class ConfigDictionary {
    - m_configuration: unordered_map<string, ConfigValue>
    + set<T>(key: string, value: T) : void
    + get<T>(key: string) : optional<T>
    + contains(key: string) : bool
    + hasType<T>(key: string) : bool
    + clear() : void
  }

  interface IConfigProvider {
    + {abstract} getKey(name: string) : ConfigValue
    + {abstract} hasKey(name: string) : bool
  }

  class EmptyConfigProvider {
    + getKey(name: string) : ConfigValue
    + hasKey(name: string) : bool
  }

  class JsonConfigProvider {
    - m_configDict: ConfigDictionary
    - loadJsonIntoDict(json: json, prefix: string) : void
    + JsonConfigProvider(configPath: filesystem::path)
    + getKey(name: string) : ConfigValue
    + hasKey(name: string) : bool
  }

  class ConfigStore {
    - m_provider: unique_ptr<IConfigProvider>
    - m_dictionary: ConfigDictionary
    + ConfigStore(provider: unique_ptr<IConfigProvider>)
    + {static} fromJsonFile(jsonPath: filesystem::path) : unique_ptr<ConfigStore>
    + get(path: string) : ConfigValue
    + has(path: string) : bool
    + reload() : void
  }

  class ConfigReader {
    - m_store: ConfigStore&
    + ConfigReader(store: ConfigStore&)
    + store() : ConfigStore&
    + floatOr(key: string, fallback: float) : float
    + intOr(key: string, fallback: int) : int
    + u64Or(key: string, fallback: Uint64) : Uint64
    + strOr(key: string, fallback: string) : string
    + colorOr(key: string, fallback: SDL_Color) : SDL_Color
    + vec2Or(base: string, fallback: Vec2) : Vec2
  }

  class ConfigAdapter {
    + ConfigAdapter(store: ConfigStore&)
    + getGameConfig() : GameConfig
  }

  struct GameConfig {
    + windowSize: Vec2
    + windowTitle: string
    + fontPath: filesystem::path
    + fontSizeSm: int
    + fontSizeMd: int
    + fontSizeLg: int
  }

  struct AudioManifest {
    + options: AudioInitOptions
    + sampleCooldowns: unordered_map<AudioSampleId, Uint64>
  }

  class AudioManifestLoader <<free function>> {
    + loadAudioManifest(manifestPath: filesystem::path, assetsDir: filesystem::path) : AudioManifest
  }
}

' Entity-Component System
package "ECS" {
  class EntityTags <<namespace>> {
    + {static} Default: EntityTag = 0
    + {static} Player: EntityTag = 1
    + {static} Wall: EntityTag = 2
    + {static} FirstGameTag: EntityTag = 16
  }

  class ComponentPool<T> {
    - {static} npos: size_t
    - m_sparse: vector<size_t>
    - m_denseIds: vector<size_t>
    - m_dense: vector<T>
    + contains(id: size_t) : bool
    + size() : size_t
    + empty() : bool
    + clear() : void
    + resizeSparse(size: size_t) : void
    + reserveDense(capacity: size_t) : void
    + emplace(id: size_t, args...) : T&
    + remove(id: size_t) : void
    + get(id: size_t) : T*
    + dense() : vector<T>&
    + denseIds() : vector<size_t>&
  }

  class ComponentRegistry {
    - m_pools: unordered_map<type_index, unique_ptr<IPool>>
    - pool<T>() : Pool<T>&
    - poolIfExists<T>() : Pool<T> const*
    + emplace<T>(id: size_t, component: shared_ptr<T>) : shared_ptr<T>
    + get<T>(id: size_t) : shared_ptr<T>
    + contains<T>(id: size_t) : bool
    + remove<T>(id: size_t) : void
    + dense<T>() : vector<shared_ptr<T>>&
    + denseIds<T>() : vector<size_t>&
    + removeAllForEntity(id: size_t) : void
  }

  class EntityManager {
    - m_entities: EntityList
    - m_toAdd: EntityList
    - m_entityMap: EntityMap
    - m_totalEntities: size_t
    - m_components: shared_ptr<ComponentRegistry>
    + addEntity(tag: EntityTag) : shared_ptr<Entity>
    + getEntities() : EntityList&
    + getEntities(tag: EntityTag) : EntityList&
    + components() : ComponentRegistry&
    + update() : void
  }

  class Entity {
    - m_active: bool
    - m_id: size_t
    - m_tag: EntityTag
    - m_registry: weak_ptr<ComponentRegistry>
    + isActive() : bool
    + tag() : EntityTag
    + id() : size_t
    + destroy() : void
    + getCenterPos() : Vec2
    + getComponent<T>() : shared_ptr<T>
    + setComponent<T>(component: shared_ptr<T>) : void
    + removeComponent<T>() : void
    + hasComponent<T>() : bool
  }

  package "Components" {
    class CTransform {
      + topLeftCornerPos: Vec2
      + velocity: Vec2
      + CTransform(position: Vec2, velocity: Vec2)
      + CTransform()
    }

    class CShape {
      + rect: SDL_FRect
      + color: SDL_Color
      + CShape(rect: SDL_FRect, color: SDL_Color)
    }

    class CInput {
      + directions: bitset<4>
    }

    enum Directions {
      Forward
      Backward
      Left
      Right
    }

    class CLifespan {
      + birthTime: Uint64
      + lifespan: Uint64
      + CLifespan()
      + CLifespan(lifespan: Uint64)
    }

    enum EffectTypes {
      Speed
      Slowness
    }

    struct Effect {
      + startTime: Uint64
      + duration: Uint64
      + type: EffectTypes
    }

    class CEffects {
      - effects: vector<Effect>
      + addEffect(effect: Effect) : void
      + getEffects() : vector<Effect> const&
      + removeEffect(type: EffectTypes) : void
      + hasEffect(type: EffectTypes) : bool
      + clearEffects() : void
    }

    class CBounceTracker {
      - m_bounces: int
      + addBounce() : void
      + getBounces() : int
    }

    class CSprite {
      - m_textureId: string_view
      + CSprite(textureId: string_view)
      + getTextureId() : string_view
    }
  }
}

