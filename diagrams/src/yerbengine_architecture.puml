@startuml
skinparam classAttributeIconSize 0
skinparam componentStyle rectangle
title YerbEngine - Detailed Class Diagram

' Core
package "Core" {
  interface ISceneRouter {
    + {abstract} LoadScene(sceneName: string, scene: shared_ptr<Scene>) : void
    + {abstract} quit() : void
  }

  class GameEngine {
    # m_video: VideoManager&
    # m_clock: IClock const&
    # m_scenes: map<string, shared_ptr<Scene>>
    # m_currentSceneName: string
    # m_isRunning: bool
    # findActiveScene() : shared_ptr<Scene>
    # Update() : void
    # {static} MainLoop(arg: void*) : void
    # S_UserInput() : void
    + GameEngine(video: VideoManager&, clock: IClock const&)
    + IsRunning() : bool
    + LoadScene(sceneName: string, scene: shared_ptr<Scene>) : void
    + run() : void
    + quit() : void
  }

  struct SceneServices {
    + video: VideoManager&
    + fonts: FontManager&
    + textures: TextureManager&
    + audio: AudioSampleBuffer&
    + mixer: AudioManager&
    + clock: IClock const&
    + router: ISceneRouter&
  }

  abstract class Scene {
    # m_services: SceneServices const&
    # m_entities: EntityManager
    # m_randomGenerator: mt19937
    # m_lastFrameTime: Uint64
    # m_deltaTime: float
    # m_endTriggered: bool
    # m_hasEnded: bool
    # m_paused: bool
    # m_SceneStartTime: Uint64
    # m_actionMap: map<int, string>
    # m_actionHandlers: unordered_map<string, function<void(Action&)>>
    # tick() : void
    + {static} MAX_FRAME_DELTA: float
    + Scene(services: SceneServices const&)
    + {abstract} update() : void
    + {abstract} onEnd() : void
    + {abstract} sRender() : void
    + virtual sDoAction(action: Action&) : void
    + virtual sAudio() : void
    + virtual onSceneWindowResize() : void
    + registerAction(inputKey: int, actionName: string) : void
    + bindAction(actionName: string, handler: function<void(Action&)>) : void
    + bindPress(actionName: string, handler: function<void(Action&)>) : void
    + bindHold(actionName: string, handler: function<void(bool)>) : void
    + setPaused(paused: bool) : void
    + getActionMap() : ActionMap const&
    + setStartTime(startTime: Uint64) : void
    + getStartTime() : Uint64 const&
  }

  class Action {
    - m_name: string
    - m_state: ActionState
    - m_pos: optional<Vec2>
    + Action(name: string, state: ActionState, pos: optional<Vec2>)
    + getName() : string const&
    + getState() : ActionState const&
    + getPos() : optional<Vec2> const&
  }

  enum ActionState {
    START
    END
  }

  class EnginePaths <<namespace>> {
    + resolveDirectory(preferred: Path, fallback: Path, label: char const*) : Path
  }
}

package "Managers" {
  package "Asset Management" {
    struct FontSizes {
      + sm: int
      + md: int
      + lg: int
    }

    class FontManager {
      - m_fontPath: Path
      - m_sizes: FontSizes
      - m_fontLg: TTF_Font*
      - m_fontMd: TTF_Font*
      - m_fontSm: TTF_Font*
      + FontManager(fontPath: Path, sizes: FontSizes)
      + ~FontManager()
      + loadFonts(fontPath: Path) : void
      + getFontLg() : TTF_Font*
      + getFontMd() : TTF_Font*
      + getFontSm() : TTF_Font*
    }

    struct RendererHandle {
      + renderer: SDL_Renderer*
    }

    class TextureManager {
      - m_renderer: SDL_Renderer*
      - m_textures: unordered_map<string, SDL_Texture*>
      + TextureManager(renderer: RendererHandle)
      + ~TextureManager()
      + registerTexture(name: string_view, path: filesystem::path) : void
      + hasTexture(name: string_view) : bool
      + getTexture(name: string_view) : SDL_Texture*
    }

    enum PriorityLevel {
      BACKGROUND
      STANDARD
      IMPORTANT
      CRITICAL
    }

    class QueuedSample <<internal>> {
      + sample: AudioSampleId
      + priority: PriorityLevel
      + timestamp: Uint64
    }

    class AudioSampleBuffer {
      - {static} SAMPLE_BUFFER_CAPACITY: size_t
      - {static} TRIM_LIMIT: size_t
      - {static} STALE_SAMPLE_MS: Uint64
      - {static} MIN_REPLAY_INTERVAL: Uint64
      - m_sampleBuffer: array<QueuedSample, SAMPLE_BUFFER_CAPACITY>
      - m_head: size_t
      - m_tail: size_t
      - m_size: size_t
      - m_lastPlayTimes: unordered_map<AudioSampleId, Uint64>
      - m_audioSink: IAudioSink&
      - m_clock: IClock const&
      - m_cooldowns: unordered_map<AudioSampleId, Uint64>
      - isBufferFull() : bool
      - pushSample(queuedSample: QueuedSample) : void
      - removeExpiredSamples(currentTime: Uint64) : void
      - removeAtOffset(offset: size_t) : void
      - evictLowerPrioritySample(incoming: PriorityLevel) : bool
      - trimLowPrioritySamples() : void
      + AudioSampleBuffer(audioSink: IAudioSink&, clock: IClock const&)
      + queueSample(sample: string_view, priority: PriorityLevel) : void
      + setCooldown(sample: string_view, cooldownMs: Uint64) : void
      + setCooldowns(cooldowns: unordered_map<AudioSampleId, Uint64>) : void
      + update() : void
    }
  }

  package "System Management" {
    class SdlRuntime {
      + SdlRuntime()
      + ~SdlRuntime()
    }

    interface IClock {
      + {abstract} nowMs() : Uint64
    }

    class SdlClock {
      + nowMs() : Uint64
    }

    interface IAudioSink {
      + {static} MAX_SAMPLES_PER_FRAME: size_t
      + {abstract} playSample(sample: string_view, loops: int) : void
    }

    struct AudioTrackDefinition {
      + id: AudioTrackId
      + filepath: Path
    }

    struct AudioSampleDefinition {
      + id: AudioSampleId
      + filepath: Path
      + defaultVolume: int
    }

    struct AudioInitOptions {
      + frequency: int
      + format: SDL_AudioFormat
      + channels: int
      + tracks: vector<AudioTrackDefinition>
      + samples: vector<AudioSampleDefinition>
    }

    class AudioManager {
      - {static} SAMPLE_VOICE_COUNT: size_t
      - m_mixer: MIX_Mixer*
      - m_audioTracks: unordered_map<AudioTrackId, MIX_Audio*>
      - m_audioSamples: unordered_map<AudioSampleId, MIX_Audio*>
      - m_sampleVolumes: unordered_map<AudioSampleId, int>
      - m_trackVoice: MIX_Track*
      - m_sampleVoices: vector<MIX_Track*>
      - m_spec: SDL_AudioSpec
      - m_currentAudioTrack: AudioTrackId
      - m_lastAudioTrack: AudioTrackId
      - m_lastAudioSample: AudioSampleId
      - m_audioTrackPaused: bool
      - m_tracksMuted: bool
      - m_samplesMuted: bool
      - m_savedTrackVolume: int
      - m_trackVolume: int
      - m_savedSampleVolumes: map<AudioSampleId, int>
      - {static} toGain(volume: int) : float
      - acquireSampleVoice() : MIX_Track*
      - loadTrack(track: AudioTrackId, filepath: Path) : void
      - loadSample(sample: AudioSampleId, filepath: Path, defaultVolume: int) : void
      - cleanup() : void
      + {static} DEFAULT_SAMPLE_VOLUME: int
      + {static} DEFAULT_TRACK_VOLUME: int
      + AudioManager()
      + AudioManager(options: AudioInitOptions)
      + ~AudioManager()
      + loadTracks(tracks: vector<AudioTrackDefinition>) : void
      + loadSamples(samples: vector<AudioSampleDefinition>) : void
      + playTrack(track: string_view, loops: int) : void
      + playSample(sample: string_view, loops: int) : void
      + stopTrack() : void
      + pauseTrack() : void
      + resumeTrack() : void
      + setTrackVolume(volume: int) : void
      + setSampleVolume(sampleTag: string_view, volume: int) : void
      + getSampleVolume(sampleTag: string_view) : int
      + getTrackVolume() : int
      + muteTracks() : void
      + unmuteTracks() : void
      + muteSamples() : void
      + unmuteSamples() : void
      + muteAll() : void
      + unmuteAll() : void
      + toggleMuteAll() : void
      + toggleMuteTracks() : void
      + toggleMuteSamples() : void
      + getCurrentAudioTrack() : AudioTrackId
      + getLastAudioTrack() : AudioTrackId
      + getLastAudioSample() : AudioSampleId
